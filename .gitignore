# Bundle artifact
*.jsbundle

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# environment files (secrets) — .env.example is the committed template
**/.env

# The content/version server lives in its own repo (Arsen27/dmv-server);
# server/ here is its working copy. Course content is generated into it by
# `npm run course:export-server`, then committed from inside server/.
/server/

# Not part of the app repo — admin panel, authoring/tooling scripts, docs.
# They exist only in the local working copy.
/admin/
/scripts/
/docs/
# Tests the ignored tooling; breaks on a clone without scripts/.
__tests__/courseImportV2.test.ts

# Local working materials — course sources, design/integration handoffs.
# The repo itself is only the mobile app; course content ships via the server repo.
/courses/
/_to_delete/
/design_handoff_dmv_prep_glass/
/*_Integration_Handoff_*/
/*.zip

# Course packages built for the content server; pushed, not committed.
/out/
