
# ---------------------------------------------------------------------------
# Content database (course releases, channels, drafts, image metadata).

# Supabase → Project Settings → Database → Connection string → Transaction
# pooler (port 6543). Railway only has IPv4 and the pooler is what answers on
# IPv4; transaction mode is why the server never uses prepared statements.
# Local runs without Supabase: pglite://.pglite (file-backed) or memory://.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
